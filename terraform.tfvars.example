# ==================================================================================================
# AutoAWS Infrastructure - Example Variables (terraform.tfvars.example)
# ==================================================================================================

# --------------------------------------------------------------------------------------------------
# 1. Project & Environment Identifiers
# --------------------------------------------------------------------------------------------------
aws_region   = "us-west-1"
project_name = "acme"
cluster_name = "acme-cluster"
environment  = "dev" # "dev", "staging", or "production"

# --------------------------------------------------------------------------------------------------
# 2. Cost-Optimized Zero-NAT Networking ($32.85/mo Saved)
# --------------------------------------------------------------------------------------------------
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
database_subnet_cidrs = ["10.0.21.0/24", "10.0.22.0/24"]
container_port        = 3000
enable_nat_gateway    = false

# --------------------------------------------------------------------------------------------------
# 3. Application Load Balancer & Swagger Security
# --------------------------------------------------------------------------------------------------
# Leave empty ("") for auto-generated self-signed ACM cert, or provide existing ACM ARN:
certificate_arn           = ""
enable_swagger_protection = true
swagger_whitelist_ips = [
  "202.89.67.216/32",
  "122.168.85.82/32",
  "202.89.77.27/32",
  "122.168.82.7/32",
  "122.168.81.182/32"
]

# --------------------------------------------------------------------------------------------------
# 4. Amazon RDS PostgreSQL (Isolated Database Subnets)
# --------------------------------------------------------------------------------------------------
enable_rds            = true
rds_instance_class    = "db.t4g.micro"
db_engine_version     = "16"
db_name               = "appdb"
db_username           = "postgres"
rds_allocated_storage = 20

# --------------------------------------------------------------------------------------------------
# 5. ECS Fargate Container Configuration (Single Container Default)
# --------------------------------------------------------------------------------------------------
container_image         = "public.ecr.aws/docker/library/node:20-alpine"
api_command             = ["sh", "-c", "node dist/server.js"]
worker_command          = ["node", "dist/worker.js"]
enable_worker_container = false
ecs_desired_count       = 1
ecs_task_cpu            = 256   # 256 units = 0.25 vCPU
ecs_task_memory         = 512   # 512 MB = 0.5 GB RAM

# --------------------------------------------------------------------------------------------------
# 6. CI/CD & Deployer Credentials
# --------------------------------------------------------------------------------------------------
enable_github_deployer_user = true
enable_github_oidc          = true
create_github_oidc_provider = true
github_org                  = "Aayushffc"
github_repo                 = "AutoAWS"

# --------------------------------------------------------------------------------------------------
# 7. Frontend (AWS Amplify Next.js SSR)
# --------------------------------------------------------------------------------------------------
enable_amplify         = false
amplify_repository_url = ""
amplify_github_token   = ""
amplify_branch         = "main"
